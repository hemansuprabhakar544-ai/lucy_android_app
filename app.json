{
  "expo": {
    "name": "Lucy",
    "slug": "lucy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
  [
    "expo-speech-recognition",
    {
      "microphonePermission": "Allow Lucy to use the microphone.",
      "speechRecognitionPermission": "Allow Lucy to convert your speech into text."
    }
  ]
],
    "scheme": "lucy",
    "android": {
      "package": "com.hemansu.lucy",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.hemansu.lucy"
    },
       "extra": {
      "eas": {
        "projectId": "2fdf140b-db11-4300-a856-57c000139188"
      }
    }
  }
}
